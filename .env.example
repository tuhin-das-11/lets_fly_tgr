# ==============================================================================
# LET'S FLY TGR — Environment Configuration Template
# Copy this file to .env and provide your actual development or production keys.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Supabase Cloud Project Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Google OAuth 2.0 Client IDs
# Web/Android client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Notion API Integration (Phase 7)
# Public Integration credentials from https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI=letsflytgr://notion-callback

# AI Study Assistant (Phase 7)
# Handled server-side in Supabase Edge Functions. Never exposed to Flutter client.
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL_NAME=gemini-1.5-flash
